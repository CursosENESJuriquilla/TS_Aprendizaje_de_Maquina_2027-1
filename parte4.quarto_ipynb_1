      "source": [
        "dfs = range(3, 16)\n",
        "\n",
        "results = []\n",
        "\n",
        "for df in dfs:\n",
        "\n",
        "    spec = MS([\n",
        "        bs(\n",
        "            \"age\",\n",
        "            df=df\n",
        "        )\n",
        "    ]).fit(Wage)\n",
        "\n",
        "    X = spec.transform(Wage)\n",
        "\n",
        "    model = sm.OLS(\n",
        "        wage,\n",
        "        X\n",
        "    ).fit()\n",
        "\n",
        "    predictions = model.predict(X)\n",
        "\n",
        "    mse = np.mean(\n",
        "        (wage - predictions) ** 2\n",
        "    )\n",
        "\n",
        "    results.append({\n",
        "        \"df\": df,\n",
        "        \"MSE_train\": mse\n",
        "    })"
      ],
