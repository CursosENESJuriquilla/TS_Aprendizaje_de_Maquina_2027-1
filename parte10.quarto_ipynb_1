      "source": [
        "Ordenamos las configuraciones:"
      ],
      "id": "61ed300c"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "resultados_grid[\n",
        "    [\n",
        "        \"param_learning_rate\",\n",
        "        \"param_n_estimators\",\n",
        "        \"param_max_depth\",\n",
        "        \"RMSE_CV\",\n",
        "        \"std_test_score\",\n",
        "        \"mean_fit_time\"\n",
        "    ]\n",
