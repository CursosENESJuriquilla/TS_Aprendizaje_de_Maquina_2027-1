      "source": [
        "Como los scores están negativos, crearemos una columna de RMSE."
      ],
      "id": "79d53fca"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "resultados_grid[\"RMSE_CV\"] = (\n",
        "    -resultados_grid[\"mean_test_score\"]\n",
