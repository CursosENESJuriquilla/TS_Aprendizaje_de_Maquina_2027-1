    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "columnas = [\n",
        "    \"param_learning_rate\",\n",
        "    \"param_n_estimators\",\n",
        "    \"param_max_depth\",\n",
        "    \"mean_test_score\",\n",
        "    \"std_test_score\",\n",
