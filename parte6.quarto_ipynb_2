        "        y_test = y[test_idx]\n",
        "\n",
        "        y_pred = lowess(\n",
        "            y_train,\n",
        "            X_train,\n",
        "            frac=span,\n",
        "            xvals=X_test\n",
        "        )\n",
        "\n",
        "        mse = mean_squared_error(\n",
        "            y_test,\n",
        "            y_pred\n",
        "        )\n",
        "\n",
        "        fold_mse.append(mse)\n",
        "\n",
        "    cv_results.append({\n",
        "        \"span\": span,\n",
        "        \"MSE\": np.mean(fold_mse)\n",
