      "source": [
        "#| label: ajuste-logit\n",
        "\n",
        "modelo_logit = sm.GLM(\n",
        "    y_logit,\n",
        "    X_logit,\n",
        "    family=sm.families.Binomial()\n",
        ").fit()\n",
        "\n",
        "summarize(modelo_logit)"
