        "\n",
        "X_pred = design_g4.transform(datos_pred)\n",
        "\n",
        "prediccion = modelo_g4.get_prediction(X_pred)\n",
        "\n",
        "# IC al 95%\n",
        "resumen_pred = prediccion.summary_frame(alpha=0.05) \n",
        "\n",
        "resumen_pred.head()"
