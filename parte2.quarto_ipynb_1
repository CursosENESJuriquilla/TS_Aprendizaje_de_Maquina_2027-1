        "#| label: prediccion-grid\n",
        "\n",
        "age_grid = np.linspace(\n",
        "    wage['age'].min(),\n",
        "    wage['age'].max(),\n",
        "    200\n",
        ")\n",
        "\n",
        "datos_pred = pd.DataFrame({\n",
