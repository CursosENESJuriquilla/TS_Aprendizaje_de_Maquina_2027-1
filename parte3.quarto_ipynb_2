      "metadata": {},
      "source": [
        "Aquí\n",
        "\n",
        "$$\\alpha=0.05$$\n",
        "\n",
        "corresponde a un nivel de confianza de\n",
        "\n",
        "$$1-\\alpha=0.95.$$\n",
